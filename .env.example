# Local development environment.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it must
# never contain a real secret.
#
# In a container none of this is required: the config folder is the interface,
# and these variables only exist because `config.example/config.json` refers to
# them through `${env:…}` placeholders (CFG-2).

# --- required -----------------------------------------------------------------

# Postgres. Everything lives in the `idp` schema, so an existing database is
# fine. Neon works and is what the dev setup uses.
#
# Under `docker compose` this line is IGNORED: the compose file builds the URL
# from POSTGRES_PASSWORD below and points it at the `postgres` service. Set it
# here when you run the IdP against a database compose does not own.
DATABASE_URL=postgres://idp:idp@localhost:5432/idp

# Only for `docker compose`, where it is the password of the Postgres the
# compose file starts. After editing it, write the same value into the file the
# database reads:
#
#   mkdir -p secrets && printf %s "$POSTGRES_PASSWORD" > secrets/postgres_password
#
# Two places for one value, on purpose — see the note at the top of
# docker-compose.yml.
POSTGRES_PASSWORD=

# Required when DATABASE_URL goes through a transaction-mode pooler (Neon's
# `-pooler` endpoint, PgBouncer). Session advisory locks do not hold through
# one — verified — so startup, migrations, the CLI and the cleanup job connect
# directly. For Neon this is the same URL without the `-pooler` suffix.
# DIRECT_DATABASE_URL=

# At least 32 random bytes: `openssl rand -base64 48`.
# Rotating this invalidates every session AND makes the encrypted signing keys
# in the `jwks` table undecryptable.
IDP_SECRET=

# --- optional -----------------------------------------------------------------

# The issuer. Defaults to http://localhost:3000. A path is supported:
# https://apps.example.com/idp
# IDP_BASE_URL=http://localhost:3000
# IDP_ORIGIN=http://localhost:3000

# Where the config folder lives. Defaults to /config in the image.
IDP_CONFIG_DIR=./config

# The first administrator — and the ONLY way to sign in on a fresh database.
# There is no default account and no built-in password: whatever you put here
# is your login. You are forced to change the password at first sign-in, after
# which these can (and should) be unset.
IDP_ADMIN_EMAIL=admin@example.com
IDP_ADMIN_PASSWORD=

# E-mail. Without it the IdP runs in degraded mode: no verification, no reset,
# no notifications (FR-MAIL-2).
# RESEND_API_KEY=

# Client secrets referenced by config.example/oauth_clients.json.
# EXAMPLE_WEB_CLIENT_SECRET=
# EXAMPLE_FIRSTPARTY_CLIENT_SECRET=

# Social providers.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=

# --- docker compose only ------------------------------------------------------

# Published port on the host. The container always listens on 3000.
# IDP_PORT=3000

# The image to run. Unset uses the published one; `docker compose build` and
# `IDP_IMAGE=semantius-idp:local` runs what you just built.
# IDP_IMAGE=ghcr.io/adenin/semantius-idp:latest

# Only when IDP_BASE_URL carries a path (OPS-10). It is the same path, and it
# exists separately because the container's health check probes 127.0.0.1 and
# has to find `/healthz` where the mount path put it.
# IDP_BASE_PATH=/idp

# The hostname Caddy gets a certificate for, with `--profile caddy`.
# IDP_DOMAIN=idp.example.com

# --- bootstrap-only variables (never read from a config file) ------------------
# HOST=0.0.0.0
# PORT=3000
# LOG_LEVEL=info
# LOG_FORMAT=pretty
# IDP_MIGRATE_ON_BOOT=true
