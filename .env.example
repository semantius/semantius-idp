# Local development environment.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it must
# never contain a real secret.
#
# In a container none of this is required: the config folder is the interface,
# and these variables only exist because `config.example/config.json` refers to
# them through `${env:…}` placeholders (CFG-2).

# --- required -----------------------------------------------------------------

# Postgres. Everything lives in the `idp` schema, so an existing database is
# fine. Neon works and is what the dev setup uses.
DATABASE_URL=postgres://idp:idp@localhost:5432/idp

# At least 32 random bytes: `openssl rand -base64 48`.
# Rotating this invalidates every session AND makes the encrypted signing keys
# in the `jwks` table undecryptable.
IDP_SECRET=

# --- optional -----------------------------------------------------------------

# The issuer. Defaults to http://localhost:3000. A path is supported:
# https://apps.example.com/idp
# IDP_BASE_URL=http://localhost:3000
# IDP_ORIGIN=http://localhost:3000

# Where the config folder lives. Defaults to /config in the image.
IDP_CONFIG_DIR=./config

# First-boot admin. Unset both again after the first sign-in.
# IDP_ADMIN_EMAIL=admin@example.com
# IDP_ADMIN_PASSWORD=

# E-mail. Without it the IdP runs in degraded mode: no verification, no reset,
# no notifications (FR-MAIL-2).
# RESEND_API_KEY=

# Client secrets referenced by config.example/oauth_clients.json.
# EXAMPLE_WEB_CLIENT_SECRET=
# EXAMPLE_FIRSTPARTY_CLIENT_SECRET=

# Social providers.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=

# --- bootstrap-only variables (never read from a config file) ------------------
# HOST=0.0.0.0
# PORT=3000
# LOG_LEVEL=info
# LOG_FORMAT=pretty
# IDP_MIGRATE_ON_BOOT=true
