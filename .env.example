# Environment for the IdP.
#
# `docker/idp-setup-env` creates `.env` from this file with a generated value
# for every secret below, and `docker/idp-create` runs it on a first run
#. Copy it by hand and the secrets are yours to fill in. `.env` is
# gitignored; this file is not, so it must never contain a real secret.
#
# Under `docker compose` this file is the container's environment: the compose
# file passes it through `env_file` unchanged, so what you write here is what
# the IdP reads. Outside Docker it is the same file `pnpm dev` loads.
#
# The config folder is still the interface; these variables exist
# because `config.example/config.jsonc` refers to them through `${env:…}`
# placeholders.

# --- required -----------------------------------------------------------------

# The whole connection string. Nothing is assembled from parts, and there
# is no secrets file to keep in step with one.
#
# As shipped this points at the Postgres `docker compose` starts — `postgres` is
# the service name on the compose network, and `sslmode=disable` is correct
# *there* and nowhere else. `idp` is the application role, not the superuser
#, and its password appears twice: here, where the IdP reads it, and in
# IDP_DB_PASSWORD below, where Postgres does. `idp-setup-env` writes the same
# generated value into both; change them by hand together. To use your own
# Postgres or Neon instead, put its URL here and ignore POSTGRES_PASSWORD and
# IDP_DB_PASSWORD entirely; the bundled database keeps running and nothing
# reads it.
#
# Running without Docker? Point this at a database your host can reach —
# `postgres://idp:idp@localhost:5432/idp`.
DATABASE_URL=postgres://idp:idp@postgres:5432/idp?sslmode=disable

# At least 32 random bytes: `openssl rand -base64 48`. `idp-setup-env`
# generates one; it is shipped empty so a hand-copied file cannot start on a
# value everybody has.
# Rotating this invalidates every session AND makes the encrypted signing keys
# in the `jwks` table undecryptable.
IDP_SECRET=

# --- optional -----------------------------------------------------------------

# The direct, non-pooled endpoint — the connection that must always work.
# Startup, migrations, the CLI and the cleanup job use it, because session
# advisory locks do not hold through a transaction-mode pooler (verified
# against Neon's `-pooler` endpoint). For Neon this is the same URL without the
# `-pooler` suffix.
#
# The two are a pair and **at least one of them must be set**. Set both
# when your Postgres offers both endpoints; set only this one and it serves
# ordinary traffic as well, which is what a plain Postgres wants. The bundled
# compose Postgres is a single unpooled endpoint, so DATABASE_URL alone is
# right there and this stays unset.
# DATABASE_URL_ADMIN=

# The two passwords of the Postgres `docker compose` starts, and nothing else
# reads them. That database is `expose:`-only, so they are knobs rather than
# exposures; both default to `idp` and `idp-setup-env` generates a value for
# each. Postgres reads them ONCE, at `initdb` on a fresh data volume — so a
# change afterwards means `docker/idp-destroy` (all data) or an `ALTER ROLE`
# by hand, not an edit here. Irrelevant when DATABASE_URL points somewhere
# else.
#
# The `postgres` superuser. The IdP never connects as it.
POSTGRES_PASSWORD=idp
# The `idp` application role — the same value as inside DATABASE_URL above.
IDP_DB_PASSWORD=idp

# The issuer. Defaults to http://localhost:3000. A path is supported:
# https://apps.example.com/idp
# IDP_BASE_URL=http://localhost:3000
# IDP_ORIGIN=http://localhost:3000

# Where the config folder lives. Ignored under `docker compose`, which mounts it
# at /config and pins this to match.
IDP_CONFIG_DIR=./config

# E-mail. Without it the IdP runs in degraded mode: no verification, no reset,
# no notifications.
# RESEND_API_KEY=

# Secrets for the two example clients in `config.example/oauth_clients.jsonc`.
# Throwaway values, shipped so a freshly copied config folder loads without an
# edit: both clients redirect to `app.example.com`, which is nobody's
# deployment. `idp-setup-env` replaces both with generated ones all the same.
# Replace them with your own clients — or delete `config/oauth_clients.jsonc`,
# which is optional — before anyone can use one.
EXAMPLE_WEB_CLIENT_SECRET=example-web-client-secret-not-a-real-one
EXAMPLE_FIRSTPARTY_CLIENT_SECRET=example-firstparty-secret-not-a-real-one

# Social providers.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=

# --- docker compose only ------------------------------------------------------

# Published port on the host. The container always listens on 3000.
# IDP_PORT=3000

# The image to run. Unset uses the published one; `docker/idp-create` builds
# locally and tags it under this name.
# IDP_IMAGE=ghcr.io/semantius/semantius-idp:latest

# Only when IDP_BASE_URL carries a path. It is the same path, and it
# exists separately because the container's health check probes 127.0.0.1 and
# has to find `/healthz` where the mount path put it.
# IDP_BASE_PATH=/idp

# The hostname Caddy gets a certificate for, with `--profile caddy`.
# IDP_DOMAIN=idp.example.com

# --- bootstrap-only variables (never read from a config file) ------------------
# HOST=0.0.0.0
# PORT=3000
# LOG_LEVEL=info
# LOG_FORMAT=pretty
# IDP_MIGRATE_ON_BOOT=true
