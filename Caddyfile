# The IdP at the root of its own domain (OPS-7, OPS-9).
#
# Use this when the IdP owns the hostname — `idp.example.com`. If it has to
# share a hostname with something else, use `Caddyfile.subpath` instead; that
# case has a rule this one does not need and is easy to get wrong.
#
# Caddy obtains and renews the certificate itself. With IDP_DOMAIN=localhost it
# issues an internal one, which is right for a local trial and trusted by
# nothing else.

{$IDP_DOMAIN:localhost} {
	encode zstd gzip

	# `server.trustProxy` MUST be true in config.json behind this (OPS-9).
	# Without it the IdP resolves every caller to Caddy's address: rate limits
	# become one shared bucket for the whole internet, and the audit trail
	# records the proxy for every event. With it, the IdP takes the rightmost
	# hop it does not trust — which is why the header is *replaced* here rather
	# than appended to, so a client cannot prepend addresses of its choosing.
	reverse_proxy idp:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}

		# Long enough for a slow sign-in, short enough that a hung upstream is
		# not held open for ever.
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}

		# Caddy stops sending new requests here as soon as the container goes
		# unhealthy, which is what makes the IdP's own drain (OPS-4) mean
		# something: `/readyz` answers 503 on SIGTERM, and this notices.
		health_uri /readyz
		health_interval 10s
		health_timeout 3s
	}

	# The IdP sets its own SEC-4 headers, including a CSP written against its
	# own pages, and Caddy must not add a second set. The one thing worth
	# adding here is HSTS, because it is a statement about the *hostname* —
	# which is Caddy's to make and not the application's.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format json
	}
}
